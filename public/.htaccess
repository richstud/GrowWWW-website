# GrowWWW - Apache rules for the built site (copied into dist/ by Vite).
# Works with the pages written by scripts/prerender-seo.mjs.
DirectoryIndex index.html
DirectorySlash Off
Options -Indexes
RewriteEngine On

# 1. One version of every URL: https + www.
#    Many hosts (serverbyt / 20i and others) handle HTTPS in front of Apache, so %{HTTPS} is always
#    "off" here - checking it alone causes an endless redirect loop. Only redirect when nothing says
#    the visitor is already on HTTPS.
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://www.growwww.in/$1 [L,R=301]

RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https [NC]
RewriteCond %{HTTP:X-Forwarded-SSL} !=on [NC]
RewriteRule ^(.*)$ https://www.growwww.in/$1 [L,R=301]

# 2. /index.html -> / (only when someone types it; the server still uses index.html internally)
RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [L,R=301]

# 3. Drop trailing slashes: /about/ -> /about
RewriteRule ^(.+)/$ /$1 [L,R=301]

# 4. Real files (assets, images, sitemap.xml, robots.txt) are served as-is
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# 5. /about -> about.html, /services/web-design -> services/web-design.html
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)$ /$1.html [L]

# 6. App routes without a pre-built page (product pages, admin) -> app shell
RewriteRule ^(products/.+|portfolio/.+|admin(/.*)?)$ /_spa.html [L]

# 7. Everything else is a real 404 (no more "soft 404s")
ErrorDocument 404 /404.html

# Caching: hashed build files for a year, HTML always re-checked
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml
</IfModule>
